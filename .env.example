# Copy to .env.local for local dev, then add the same keys in Vercel:
# Project → Settings → Environment Variables → Redeploy after saving.

# ── Auth.js (required — missing AUTH_SECRET causes "Configuration" error) ──
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Database (Neon PostgreSQL — shared with backend) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true

# ── OAuth providers ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_ID=your-github-oauth-app-client-id
GITHUB_SECRET=your-github-oauth-app-client-secret

# ── Backend API (Express on Vercel or Northflank) ──
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Optional (email — only if used in frontend) ──
# RESEND_API_KEY=re_your_resend_api_key
